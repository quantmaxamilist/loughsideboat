---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/site/PageHero.astro';
import BoatCard from '../../components/boats/BoatCard.astro';
import EnquiryBand from '../../components/site/EnquiryBand.astro';
import { boats } from '../../data/boats';
import { boatsPage as b, sellBand } from '../../data/site';
---
<Base title={b.title} description={`${b.intro} ${boats.map((x) => x.title).join(', ')}.`}>
  <PageHero kicker={`${boats.length} boats listed`} title={b.h1} intro={b.intro} photo="trailer" pos="50% 55%" cta="Send an Enquiry" href="/contact?service=buying" />
  <section class="bl section">
    <div class="container bl__grid">
      {boats.map((x, i) => <BoatCard boat={x} tone="light" i={i} />)}
    </div>
  </section>
  <EnquiryBand title={sellBand.title} text={sellBand.text} href="/contact?service=selling" />
</Base>
<style>
  .bl__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7) var(--s-6); }
  @media (max-width: 860px) { .bl__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
