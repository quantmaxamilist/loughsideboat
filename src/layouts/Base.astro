---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/questrial/400.css';
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { site } from '../data/site';
interface Props { title: string; description?: string; image?: string; noindex?: boolean }
const { title, description = site.intro + ' ' + site.introSub, image = '/img/john-helm-1440.webp', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/', site.url).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', name: site.name, url: site.url,
  telephone: site.phone.tel, email: site.email, description: site.intro,
  areaServed: 'Lough Erne, County Fermanagh', image: new URL(image, site.url).href,
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b1c32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="cursor" aria-hidden="true" data-cursor><span class="cursor__ring"></span><span class="cursor__dot"></span></div>
    <script>
      import { boot } from '../scripts/core.js';
      boot();
    </script>
  </body>
</html>
