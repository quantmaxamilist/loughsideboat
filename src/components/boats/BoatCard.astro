---
import Photo from '../site/Photo.astro';
import Arrow from '../site/Arrow.astro';
import type { Boat } from '../../data/boats';
interface Props { boat: Boat; tone?: 'dark' | 'light'; i?: number }
const { boat, tone = 'light', i = 0 } = Astro.props;
---
<article class:list={['card', `card--${tone}`]} data-reveal data-reveal-delay={i * 90}>
  <a class="card__media photo" href={`/boats-for-sale/${boat.slug}`} aria-label={boat.title}>
    <Photo name={boat.photos[0]} alt={boat.title} sizes="(max-width: 760px) 100vw, 45vw" />
    {boat.status && <span class:list={['card__status label', { 'is-sold': boat.sold }]}><i></i>{boat.status}</span>}
  </a>
  <div class="card__body">
    <p class="label card__meta"><span>{boat.year}</span><span>{boat.make}</span>{boat.location && <span>{boat.location}</span>}</p>
    <h3 class="display card__h"><a href={`/boats-for-sale/${boat.slug}`}>{boat.title}</a></h3>
    {(boat.headline || boat.summary) && <p class="card__sum">{boat.headline || boat.summary}</p>}
    <div class="card__foot">
      <p class="card__price">{boat.price}</p>
      <div class="card__act">
        <a class="btn" href={`/boats-for-sale/${boat.slug}`}>View boat<Arrow /></a>
        {!boat.sold && <a class:list={['btn', tone === 'dark' ? 'btn--ghost' : 'btn--ghost-dark']} href={`/contact?boat=${boat.slug}`}>Enquire</a>}
      </div>
    </div>
  </div>
</article>
<style>
  .card { display: grid; grid-template-rows: auto 1fr; border-top: 1px solid var(--line); }
  .card--dark { border-color: var(--line-dark); }
  .card__media { position: relative; display: block; aspect-ratio: 3 / 2; margin-top: var(--s-5); border-radius: var(--radius); }
  .card__media :global(img) { transition: transform 1s var(--ease-out); }
  .card__media:hover :global(img) { transform: scale(1.035); }
  .card__status { position: absolute; left: var(--s-4); top: var(--s-4); display: inline-flex; align-items: center; gap: 0.55em; padding: 0.55em 0.8em; background: rgba(7, 19, 38, 0.82); color: var(--white); border-radius: var(--radius); }
  .card__status i { width: 7px; height: 7px; border-radius: 50%; background: var(--go); box-shadow: 0 0 0 3px rgba(63, 174, 122, 0.25); }
  .card__status.is-sold i { background: #f2a33a; box-shadow: 0 0 0 3px rgba(242, 163, 58, 0.25); }
  .card__body { display: grid; align-content: start; gap: var(--s-3); padding-top: var(--s-5); }
  .card__meta { display: flex; flex-wrap: wrap; gap: 0.4em 1.1em; color: var(--ink-3); }
  .card--dark .card__meta { color: var(--on-dark-3); }
  .card__h { font-size: var(--fs-display-3); line-height: 1.05; max-width: 18ch; }
  .card__sum { color: var(--ink-2); max-width: 46ch; }
  .card--dark .card__sum { color: var(--on-dark-2); }
  .card__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-4); margin-top: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .card--dark .card__foot { border-color: var(--line-dark); }
  .card__price { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-statement); letter-spacing: -0.01em; }
  .card__act { display: flex; gap: var(--s-2); flex-wrap: wrap; }
</style>
