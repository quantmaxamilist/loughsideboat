---
// Inner-page hero: the client's photo full-bleed under a translucent navy shade (never a solid panel).
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
import { site } from '../../data/site';
interface Props { kicker: string; title: string; intro?: string; photo?: string; pos?: string; posMobile?: string; cta?: string; href?: string; compact?: boolean; tall?: boolean }
const { kicker, title, intro, photo, pos = '50% 50%', posMobile, cta, href = '/contact', compact = false, tall = false } = Astro.props;
---
<section class:list={['ph', { 'ph--compact': compact, 'ph--photo': !!photo, 'ph--tall': tall }]}>
  {photo && <div class="ph__bg" style={`--pos:${pos};--pos-m:${posMobile ?? pos}`}><Photo name={photo} alt="" priority sizes="100vw" /></div>}
  <div class="ph__shade" aria-hidden="true"></div>
  <div class="container ph__in">
    <p class="label label-row ph__k">{kicker}</p>
    <h1 class="display ph__h">{title}</h1>
    {intro && <p class="lead ph__intro">{intro}</p>}
    <div class="ph__act">
      {cta && <a class="btn" href={href}>{cta}<Arrow /></a>}
      <a class="ph__tel" href={`tel:${site.phone.tel}`}><span class="label">Call {site.phone.who}</span>{site.phone.display}</a>
    </div>
    <slot />
  </div>
</section>
<style>
  .ph { position: relative; isolation: isolate; background: var(--navy); color: var(--on-dark); min-height: min(78svh, 760px); display: flex; align-items: flex-end; padding-top: calc(var(--header-h) + var(--s-8)); padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); overflow: hidden; }
  .ph--compact { min-height: 0; }
  .ph--tall { min-height: 100svh; }
  .ph__bg { position: absolute; inset: 0; z-index: -2; }
  .ph__bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }
  .ph__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(7, 19, 38, 0.82) 0%, rgba(7, 19, 38, 0.55) 38%, rgba(7, 19, 38, 0.08) 68%, rgba(7, 19, 38, 0) 100%), linear-gradient(0deg, rgba(7, 19, 38, 0.65) 0%, rgba(7, 19, 38, 0) 45%), linear-gradient(180deg, rgba(7, 19, 38, 0.55) 0%, rgba(7, 19, 38, 0) 22%); }
  .ph:not(.ph--photo) .ph__shade { background: radial-gradient(120% 90% at 85% 0%, var(--navy-2) 0%, var(--navy) 60%); }
  .ph__in { position: relative; }
  .ph__k { color: var(--lough-light); margin-bottom: var(--s-5); }
  .ph__h { font-size: var(--fs-hero); line-height: 0.98; max-width: 14ch; text-shadow: 0 1px 24px rgba(7, 19, 38, 0.35); }
  .ph__intro { margin-top: var(--s-5); max-width: 46ch; color: var(--on-dark-2); }
  .ph__act { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-6); margin-top: var(--s-6); }
  .ph__tel { display: grid; font-family: var(--font-mono); font-size: 1.05rem; line-height: 1.35; }
  .ph__tel .label { color: var(--on-dark-3); font-size: 0.6875rem; }
  @media (max-width: 760px) {
    .ph { min-height: min(86svh, 720px); }
    .ph--compact { min-height: 0; }
    .ph__bg :global(img) { object-position: var(--pos-m); }
    .ph__shade { background: linear-gradient(0deg, rgba(7, 19, 38, 0.9) 0%, rgba(7, 19, 38, 0.62) 45%, rgba(7, 19, 38, 0.15) 75%, rgba(7, 19, 38, 0.45) 100%); }
  }
</style>
