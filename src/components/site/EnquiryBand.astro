---
// The loud colour moment: propeller blue. Title/text come from each page's own closing band on the old site.
import Arrow from './Arrow.astro';
import { site } from '../../data/site';
interface Props { title: string; text?: string; cta?: string; href?: string }
const { title, text, cta = 'Send an Enquiry', href = '/contact' } = Astro.props;
---
<section class="band on-blade" aria-labelledby="band-h">
  <div class="container band__in">
    <div class="band__copy" data-reveal>
      <p class="label label-row band__k">Talk to Loughside</p>
      <h2 id="band-h" class="display d2">{title}</h2>
      {text && <p class="lead band__t">{text}</p>}
    </div>
    <div class="band__act" data-reveal>
      <a class="btn btn--light band__btn" href={href}>{cta}<Arrow /></a>
      <ul class="band__tels">
        {site.phones.map((p) => (<li><a href={`tel:${p.tel}`}><span class="label">{p.who}</span><span class="band__num">{p.display}</span></a></li>))}
      </ul>
    </div>
  </div>
  <svg class="band__wake" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 330 C 300 300, 520 210, 1200 40" /><path d="M0 370 C 320 340, 560 250, 1200 110" /><path d="M0 400 C 340 380, 600 300, 1200 185" />
  </svg>
</section>
<style>
  .band { position: relative; overflow: hidden; padding-block: clamp(4rem, 3rem + 5vw, 7.5rem); }
  .band__in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--s-7); align-items: end; }
  .band__k { color: rgba(255, 255, 255, 0.72); margin-bottom: var(--s-4); }
  .band h2 { max-width: 16ch; }
  .band__t { margin-top: var(--s-5); max-width: 44ch; color: rgba(255, 255, 255, 0.86); }
  .band__act { display: grid; gap: var(--s-5); justify-items: start; }
  .band__tels { display: grid; gap: var(--s-2); width: 100%; }
  .band__tels a { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); padding-block: 0.7rem; border-top: 1px solid rgba(255, 255, 255, 0.25); }
  .band__tels .label { color: rgba(255, 255, 255, 0.7); }
  .band__num { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-statement); letter-spacing: -0.01em; transition: transform var(--dur) var(--ease-out); }
  .band__tels a:hover .band__num { transform: translateX(-4px); }
  .band__wake { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .band__wake path { fill: none; stroke: rgba(255, 255, 255, 0.09); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  @media (max-width: 860px) { .band__in { grid-template-columns: minmax(0, 1fr); align-items: start; } }
</style>
