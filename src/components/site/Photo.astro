---
// Responsive graded photo from public/img (built by scripts/photos.py). Width/height carried to prevent CLS.
// `name` can also be a remote photo from the CRM ({ src, srcset, w, h }).
import photos from '../../data/photos.json';
import type { PhotoRef } from '../../data/boats';
interface Props { name: PhotoRef; alt: string; sizes?: string; class?: string; loading?: 'lazy' | 'eager'; priority?: boolean; pos?: string }
const { name, alt, sizes = '100vw', class: cls = '', loading = 'lazy', priority = false, pos } = Astro.props;
let src: string, srcset: string, p: { w: number; h: number };
if (typeof name === 'string') {
  const local = (photos as any)[name];
  if (!local) throw new Error('unknown photo ' + name);
  p = local;
  srcset = local.widths.map((w: number) => `/img/${name}-${w}.webp ${w}w`).join(', ');
  src = `/img/${name}-${local.widths.filter((w: number) => w <= 1440).at(-1)}.webp`;
} else {
  p = name; src = name.src; srcset = name.srcset;
}
---
<img
  class={cls}
  src={src}
  srcset={srcset}
  sizes={sizes}
  width={p.w}
  height={p.h}
  alt={alt}
  loading={priority ? 'eager' : loading}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
  style={pos ? `object-position:${pos}` : undefined}
/>
