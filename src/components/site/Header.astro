---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { nav, site } from '../../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const active = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hdr" data-hdr>
  <div class="hdr__in container">
    <a href="/" class="hdr__logo" aria-label="Loughside Boat Sales — home"><Logo tone="light" /></a>
    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} class:list={['hdr__link', { 'is-active': active(n.href) }]} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="hdr__cta">
      <a class="hdr__tel" href={`tel:${site.phone.tel}`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.6 2.5 4 3.3c-.9.3-1.4 1.2-1.2 2.1.9 4.9 4.9 9 9.8 9.9.9.2 1.8-.3 2.1-1.2l.8-2.6-3.6-1.6-1.4 1.7a8.4 8.4 0 0 1-4.1-4.1l1.7-1.4z" fill="currentColor"/></svg>
        <span>{site.phone.display}</span>
      </a>
      <a class="btn hdr__btn" href="/contact">Send an Enquiry<Arrow /></a>
    </div>
    <a class="hdr__tel-m" href={`tel:${site.phone.tel}`} aria-label={`Call ${site.phone.display}`}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.6 2.5 4 3.3c-.9.3-1.4 1.2-1.2 2.1.9 4.9 4.9 9 9.8 9.9.9.2 1.8-.3 2.1-1.2l.8-2.6-3.6-1.6-1.4 1.7a8.4 8.4 0 0 1-4.1-4.1l1.7-1.4z" fill="currentColor"/></svg>
    </a>
    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mmenu" data-menu-open>
      <span class="sr-only">Menu</span><i></i><i></i>
    </button>
  </div>
</header>

<div class="mmenu" id="mmenu" hidden data-menu>
  <div class="mmenu__top container">
    <a href="/" class="hdr__logo" aria-label="Loughside Boat Sales — home"><Logo tone="light" /></a>
    <button class="mmenu__close" type="button" data-menu-close aria-label="Close menu"><i></i><i></i></button>
  </div>
  <nav class="mmenu__nav container" aria-label="Mobile">
    <ol>
      <li><a href="/"><span class="label">00</span>Home</a></li>
      {nav.map((n, i) => (<li><a href={n.href} aria-current={active(n.href) ? 'page' : undefined}><span class="label">{String(i + 1).padStart(2, '0')}</span>{n.label}</a></li>))}
    </ol>
  </nav>
  <div class="mmenu__foot container">
    {site.phones.map((p) => (<a href={`tel:${p.tel}`}><span class="label">{p.who}</span>{p.display}</a>))}
    <a class="btn btn--light" href="/contact">Send an Enquiry<Arrow /></a>
  </div>
</div>

<style>
  .hdr { view-transition-name: site-header; position: fixed; inset: 0 0 auto; z-index: var(--z-header); height: var(--header-h); color: var(--on-dark); transition: background-color var(--dur) var(--ease-out), box-shadow var(--dur), transform 0.45s var(--ease-out); }
  .hdr.is-solid { background: rgba(11, 28, 50, 0.95); box-shadow: 0 1px 0 var(--line-dark); }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr__in { height: 100%; display: flex; align-items: center; gap: var(--s-6); }
  .hdr__logo { display: block; height: 58px; flex: none; --logo-knock: transparent; }
  .hdr__nav { margin-left: auto; }
  .hdr__nav ul { display: flex; gap: clamp(1rem, 1.6vw, 1.75rem); }
  .hdr__link { position: relative; display: inline-flex; align-items: center; height: 44px; font-size: 0.9375rem; font-weight: 500; color: var(--on-dark-2); transition: color var(--dur-fast); }
  .hdr__link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 8px; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform var(--dur) var(--ease-out); }
  .hdr__link:hover, .hdr__link.is-active { color: var(--white); }
  .hdr__link:hover::after, .hdr__link.is-active::after { transform: scaleX(1); }
  .hdr__cta { display: flex; align-items: center; gap: var(--s-5); padding-left: var(--s-5); border-left: 1px solid var(--line-dark); }
  .hdr__tel { display: inline-flex; align-items: center; gap: 0.5em; height: 44px; font-family: var(--font-mono); font-size: 0.875rem; letter-spacing: 0.02em; white-space: nowrap; }
  .hdr__tel svg { width: 15px; height: 15px; color: var(--lough-light); }
  .hdr__btn { min-height: 44px; font-size: 0.9rem; }
  .hdr__tel-m, .hdr__burger { display: none; }

  @media (max-width: 1180px) {
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__tel-m, .hdr__burger { display: grid; place-items: center; width: 44px; height: 44px; }
    .hdr__tel-m { margin-left: auto; border-radius: var(--radius); background: var(--blade); }
    .hdr__tel-m svg { width: 18px; height: 18px; }
    .hdr__burger { position: relative; }
    .hdr__burger i, .mmenu__close i { position: absolute; left: 11px; right: 11px; height: 1.5px; background: currentColor; }
    .hdr__burger i:first-of-type { top: 17px; } .hdr__burger i:last-of-type { top: 26px; }
  }
  @media (max-width: 760px) { .hdr__logo { height: 48px; } .hdr__in { gap: var(--s-3); } }

  .mmenu { position: fixed; inset: 0; z-index: var(--z-menu); background: var(--navy); color: var(--on-dark); display: flex; flex-direction: column; overflow-y: auto; }
  .mmenu__top { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); flex: none; }
  .mmenu__close { position: relative; width: 44px; height: 44px; }
  .mmenu__close i { top: 21px; } .mmenu__close i:first-of-type { transform: rotate(45deg); } .mmenu__close i:last-of-type { transform: rotate(-45deg); }
  .mmenu__nav { padding-block: var(--s-6); flex: 1; }
  .mmenu__nav a { display: flex; align-items: baseline; gap: var(--s-4); padding-block: 0.55rem; font-family: var(--font-display); font-weight: var(--w-display); font-size: clamp(1.75rem, 7vw, 2.5rem); letter-spacing: var(--track-head); line-height: 1.1; border-bottom: 1px solid var(--line-dark); }
  .mmenu__nav a[aria-current] { color: var(--lough-light); }
  .mmenu__nav .label { color: var(--on-dark-3); width: 2.2em; flex: none; }
  .mmenu__foot { display: grid; gap: var(--s-3); padding-bottom: var(--s-7); }
  .mmenu__foot > a:not(.btn) { display: flex; justify-content: space-between; align-items: center; min-height: 44px; font-family: var(--font-mono); font-size: 1.05rem; }
  .mmenu__foot .label { color: var(--on-dark-3); }
  .mmenu__foot .btn { justify-content: space-between; margin-top: var(--s-3); }
</style>
